---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<Base title="Chauncy — Automatic Knowledge Discovery for Your Documents" description="Chauncy connects your PDFs, emails, notes, and files automatically. Ask questions in plain English. Discover connections without organizing. Fully local, fully private.">

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <h1>Your documents know more than you think.</h1>
      <p class="hero-sub">
        Chauncy connects your PDFs, emails, notes, and files — automatically — so you can stop organizing and start finding.
      </p>
      <p class="hero-body">
        Ask a question in plain English. Chauncy searches everything you've ever saved and surfaces what's connected — across formats, across time, without a filing system.
      </p>
      <div class="hero-actions">
        <a href="/pricing" class="btn btn-primary">Get Chauncy</a>
        <a href="#how-it-works" class="btn btn-secondary">See How It Works</a>
      </div>
      <p class="hero-platforms">Windows &middot; Linux &middot; macOS (coming soon)</p>
    </div>
  </section>

  <!-- The Problem -->
  <section class="section-alt">
    <div class="container problem-block">
      <h2>You already have the knowledge. It's just scattered.</h2>
      <p>
        Most knowledge tools make you do the work. You link documents manually, build folder hierarchies, create tags and categories — and then hope you remember to maintain it six months from now.
      </p>
      <p>
        Most people don't. Documents pile up. Connections go unmade. The information you need is in there somewhere, but "somewhere" isn't good enough.
      </p>
      <p>
        Chauncy doesn't ask you to organize. It discovers connections automatically, the moment you drop a file in.
      </p>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="section">
    <div class="container">
      <h2 class="section-heading">Three steps. No setup.</h2>
      <div class="steps-grid">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Drop your files in.</h3>
          <p>PDFs, emails, Word docs, notes, web clips — Chauncy accepts all of it. No reformatting, no importing ritual.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Ask in plain English.</h3>
          <p>"What did I save about the Henderson project?" "Emails from last month about the contract?" No query syntax. No filters. Just a question.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Discover what's connected.</h3>
          <p>Open any document and Chauncy shows you everything related to it — automatically, based on meaning, not keywords.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section-alt">
    <div class="container">
      <h2 class="section-heading">Everything you need. Nothing you don't.</h2>
      <div class="features-grid">
        <FeatureCard
          title="Ask, don't search."
          description="Type a question the way you'd say it out loud. Chauncy understands meaning, not just matching words. Find things you've forgotten you had."
        />
        <FeatureCard
          title="Links you didn't have to make."
          description="Open any document and see what else in your collection relates to it. Chauncy discovers these connections using AI — no manual linking required."
        />
        <FeatureCard
          title="Drop it in. All of it."
          description="PDFs, emails, Markdown, Word, PowerPoint, web clips, typed notes, voice notes. If you have it, Chauncy can work with it."
        />
        <FeatureCard
          title="Your documents stay on your machine."
          description="Chauncy stores everything locally — no account, no cloud sync, no telemetry. Search and discovery run entirely offline. If you use an AI feature, relevant excerpts go to the API provider you've chosen. You control when that happens and which provider receives it."
        />
        <FeatureCard
          title="One input. No learning curve."
          description="There's no dashboard to configure, no filter panel to learn. One text field. Ask your question. Get your answer."
        />
        <FeatureCard
          title="You choose the AI. You own the key."
          description="Connect OpenAI, Anthropic, Groq, or any compatible endpoint. Core search and discovery work without AI at all — it's an option, not a requirement."
        />
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="section">
    <div class="container privacy-block">
      <h2>Private by design. Not by policy.</h2>
      <p>
        Most tools promise privacy in their terms of service. Chauncy delivers it by architecture.
      </p>
      <p>
        Your documents, your search index, and all discovered connections live in a database on your computer. Chauncy has no servers to breach, no account to compromise, and no telemetry to disable.
      </p>
      <p>
        When you use an AI feature — summarization, deeper analysis — relevant excerpts are sent to the API provider you choose. You select the provider, you supply the key, and their privacy policy governs that data. Chauncy is transparent about exactly when this happens.
      </p>
      <p>
        If you need fully offline AI analysis, point Chauncy at a local model. It supports that too.
      </p>
      <blockquote>
        "No account. No cloud. No telemetry. Just your documents, on your machine."
      </blockquote>
    </div>
  </section>

  <!-- Pricing CTA -->
  <section class="section-alt">
    <div class="container cta-block">
      <h2>One price. Yours to keep.</h2>
      <p>No subscription. No monthly fee. Buy Chauncy once and it's yours.</p>
      <a href="/pricing" class="btn btn-primary">See Pricing</a>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
  }

  .hero-sub {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .hero-body {
    margin-top: 0.75rem;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-platforms {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .problem-block {
    max-width: 680px;
  }

  .problem-block h2 {
    margin-bottom: 1.5rem;
  }

  .problem-block p {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .step {
    text-align: center;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .step h3 {
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .privacy-block {
    max-width: 680px;
  }

  .privacy-block h2 {
    margin-bottom: 1.5rem;
  }

  .privacy-block p {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .privacy-block blockquote {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 8px 8px 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    font-style: italic;
  }

  .cta-block {
    text-align: center;
    max-width: 600px;
  }

  .cta-block p {
    margin: 1rem 0 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
</style>
