---
import Base from '../layouts/Base.astro';

const windowsDownloadUrl = 'https://github.com/JayKeenan/chauncy-releases/releases/download/v0.1.0/Chauncy_0.1.0_x64-setup.exe';
---

<Base title="Download Chauncy for Windows" description="Download the Chauncy 0.1.0 Windows installer and verify the release checksum.">

  <section class="section">
    <div class="container ty-container">
      <p class="eyebrow">Windows installer ready</p>
      <h1>Download Chauncy for Windows.</h1>
      <p class="ty-sub">
        This page is reserved for post-purchase delivery. Download the signed Windows installer below, then keep the checksum for verification if needed.
      </p>

      <a class="btn btn-primary download-btn" href={windowsDownloadUrl}>Download Chauncy 0.1.0 for Windows</a>

      <div class="status-card">
        <h2>Release details</h2>
        <ul>
          <li>Windows installer: hosted on the public Chauncy releases repository</li>
          <li>Installer filename: Chauncy_0.1.0_x64-setup.exe</li>
          <li>SHA-256: E3888552745961F3E0430CDF9C2D47F076C379068E6BBE31B4B731A05349C81B</li>
          <li>Version: 0.1.0</li>
          <li>Platform: Windows x64</li>
        </ul>
      </div>

      <div class="setup-note">
        <p><strong>Privacy model:</strong> Chauncy is a desktop application. Your documents and local search index stay on your machine. Optional AI features only send selected excerpts to the provider you configure.</p>
      </div>

      <div class="help-note">
        <p>Need help with installation? Email <a href="mailto:support@chauncy.dev">support@chauncy.dev</a>.</p>
      </div>
    </div>
  </section>

</Base>

<style>
  .ty-container {
    max-width: 760px;
    text-align: center;
    padding-top: 3rem;
  }

  .ty-sub {
    margin: 1rem auto 2rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.75;
    max-width: 620px;
  }

  .download-btn {
    margin-bottom: 1rem;
  }

  .status-card,
  .setup-note,
  .help-note {
    margin-top: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    text-align: left;
  }

  .status-card ul {
    margin-top: 1rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .status-card li,
  .setup-note p,
  .help-note p {
    color: var(--color-text-muted);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .status-card li::before {
    content: '• ';
    color: var(--color-primary);
  }
</style>
