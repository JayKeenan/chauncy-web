---
// macOS waitlist signup — can be upgraded to Formspree/Buttondown later
---

<div class="waitlist-form">
  <h3>Get notified when Chauncy is available for macOS</h3>
  <p class="waitlist-cta">Drop us a line and we'll email you when it ships.</p>
  <a href="mailto:waitlist@chauncy.dev?subject=macOS%20Waitlist" class="btn btn-primary">Join Waitlist</a>
</div>

<style>
  .waitlist-form {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    text-align: center;
  }

  .waitlist-form h3 {
    margin-bottom: 0.5rem;
  }

  .waitlist-cta {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }
</style>
